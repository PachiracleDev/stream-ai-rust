# RELAY_DOTENV_PATH=/opt/interview-relay/.env
# RELAY_PROMPTS_DIR=prompts

RELAY_JWT_SECRET=secret
# RELAY_SKIP_JWT=1

RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECS=60
PORT=6400

INTERVIEW_AGENT_MAX_HISTORY=10

# ── Cerebras ──
CEREBRAS_API_KEY=
# CEREBRAS_URL=https://api.cerebras.ai/v1/chat/completions

# assistant-relay (respuesta candidato)
CEREBRAS_RELAY_MODEL=qwen-3.8-27b
CEREBRAS_RELAY_MAX_TOKENS=1500

# question-detect (pregunta nueva)
CEREBRAS_DETECT_MODEL=gpt-oss-120b
CEREBRAS_DETECT_MAX_TOKENS=256

# image-solver (multimodal)
CEREBRAS_IMAGE_MODEL=qwen-3.8-27b
CEREBRAS_IMAGE_MAX_TOKENS=4000
# Hosts HTTPS desde los que el relay puede descargar imágenes antes de enviarlas a Cerebras.
IMAGE_FETCH_ALLOWED_HOSTS=temporalassets.s3.us-east-1.amazonaws.com
IMAGE_FETCH_MAX_BYTES=8388608
IMAGE_FETCH_TIMEOUT_SECS=10

CEREBRAS_TEMPERATURE=0.2
CEREBRAS_TOP_P=1
CEREBRAS_REASONING_EFFORT=low
# Overrides por perfil (opcional; default: CEREBRAS_REASONING_EFFORT):
# CEREBRAS_RELAY_REASONING_EFFORT=low
# CEREBRAS_DETECT_REASONING_EFFORT=low
# CEREBRAS_IMAGE_REASONING_EFFORT=low
# CEREBRAS_TRANSLATION_REASONING_EFFORT=low

# TRANSLATION_RATE_LIMIT_MAX=120

# expand-response (Groq + prompts/deepener.md)
GROQ_API_KEY=
# MODEL_DEEPENER=groq
# MAX_TOKENS_DEEPENER=512
